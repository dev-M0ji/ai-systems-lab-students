# Copia este archivo como .env y completa los valores.
# El archivo .env NUNCA se sube al repositorio (está en .gitignore).

# Proveedor: groq | openrouter | openai | deepseek
#   groq y openrouter tienen plan gratuito; openai y deepseek requieren saldo (de pago)
LLM_PROVIDER=groq

# API key del proveedor elegido
#   Groq:       https://console.groq.com/keys
#   OpenRouter: https://openrouter.ai/keys
#   OpenAI:     https://platform.openai.com/api-keys
#   DeepSeek:   https://platform.deepseek.com/api_keys
LLM_API_KEY=

# Modelo (verifica la lista vigente en la consola del proveedor)
#   Groq:       llama-3.3-70b-versatile
#   OpenRouter: meta-llama/llama-3.3-70b-instruct:free
#   OpenAI:     gpt-4.1-mini
#   DeepSeek:   deepseek-chat
LLM_MODEL=llama-3.3-70b-versatile

# Parámetros por defecto del modelo
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512

# --- Lab 02 (RAG) -----------------------------------------------------------
# Opcionales: si no se definen se usan estos valores.
# Después de cambiar EMBEDDING_MODEL o RAG_CHUNK_*, vuelve a ejecutar ingest.py.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_CHUNK_SIZE=80
RAG_CHUNK_OVERLAP=20
RAG_TOP_K=4
RAG_MIN_SCORE=0.35
